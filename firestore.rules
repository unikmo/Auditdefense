rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function hasOrg(orgId) {
      return signedIn() && request.auth.token.orgId != null && request.auth.token.orgId == orgId;
    }

    // Minimal profile surface. Users can only read/write their own profile.
    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }

    // Organization data requires an orgId custom claim. This is intentionally
    // unusable until server-side membership provisioning is implemented.
    match /organizations/{orgId} {
      allow read: if hasOrg(orgId);
      allow write: if false;

      match /cases/{caseId} {
        allow read: if hasOrg(orgId);
        allow create, update, delete: if false;

        match /{document=**} {
          allow read: if hasOrg(orgId);
          allow write: if false;
        }
      }
    }

    // Synthetic demo-only records. Still scoped to the authenticated owner.
    match /demoCases/{caseId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.synthetic == true;
      allow read, update: if signedIn() && resource.data.ownerUid == request.auth.uid
                          && resource.data.synthetic == true;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Deny every other Firestore path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
