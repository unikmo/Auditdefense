{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/app", "destination": "/app" },
    { "source": "/dashboard", "destination": "/app" },
    { "source": "/provider", "destination": "/provider" },
    { "source": "/provider/onboarding", "destination": "/provider-onboarding" },
    { "source": "/provider-onboarding", "destination": "/provider-onboarding" },
    { "source": "/attorney", "destination": "/attorney" },
    { "source": "/law-firm", "destination": "/attorney" },
    { "source": "/attorney/demo", "destination": "/attorney-workspace" },
    { "source": "/attorney/workspace", "destination": "/attorney-workspace" },
    { "source": "/attorneys", "destination": "/attorneys" },
    { "source": "/attorney-directory", "destination": "/attorneys" },
    { "source": "/resources", "destination": "/resources" },
    { "source": "/healthcare-payer-audit-response", "destination": "/healthcare-payer-audit-response" },
    { "source": "/healthcare-overpayment-demand", "destination": "/healthcare-overpayment-demand" },
    { "source": "/medicaid-provider-audit", "destination": "/medicaid-provider-audit" },
    { "source": "/behavioral-health-audit-response", "destination": "/behavioral-health-audit-response" },
    { "source": "/aba-provider-audit", "destination": "/aba-provider-audit" },
    { "source": "/npi-provider-enrollment-audit", "destination": "/npi-provider-enrollment-audit" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
