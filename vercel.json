{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/dashboard", "destination": "/app.html" },
    { "source": "/provider", "destination": "/provider.html" },
    { "source": "/provider/onboarding", "destination": "/provider-onboarding.html" },
    { "source": "/provider-onboarding", "destination": "/provider-onboarding.html" },
    { "source": "/attorney", "destination": "/attorney.html" },
    { "source": "/law-firm", "destination": "/attorney.html" },
    { "source": "/attorney/demo", "destination": "/attorney-workspace.html" },
    { "source": "/attorney/workspace", "destination": "/attorney-workspace.html" },
    { "source": "/attorneys", "destination": "/attorneys.html" },
    { "source": "/attorney-directory", "destination": "/attorneys.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
